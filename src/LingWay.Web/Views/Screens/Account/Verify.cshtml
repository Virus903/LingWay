@* Разметка: functional.js: verify. Значения передаёт одноимённая функция JavaScript. *@
<script type="text/x-lingway-template" id="Account.Verify.1">
<div class="auth-wrap single-auth verify-auth">
  <section class="auth-form">
    <form
      class="form-box verify-card"
      onsubmit="
        event.preventDefault();
        verifySubmit(this);
      "
    >
      <div class="verify-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="3" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </div>
      <h2>Подтвердите почту</h2>
      <p class="verify-copy">Введите шестизначный код, отправленный на</p>
      <strong class="verify-email">{{data_user__email_0}}</strong>
      <div class="field verify-field">
        <label for="verification-code">Код подтверждения</label>
        <input
          class="input verification-code"
          id="verification-code"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          placeholder="000000"
          required
          autofocus
        />
      </div>
      <button class="btn full">Подтвердить</button>
      <p class="verify-expiry">Код действует 15 минут</p>
      <div class="verify-actions">
        <button class="text-button" type="button" onclick="sendCode('verify')">
          Отправить код ещё раз
        </button>
        <span>·</span>
        <button class="text-button" type="button" onclick="logout()">Выйти</button>
      </div>
    </form>
  </section>
</div>
</script>
