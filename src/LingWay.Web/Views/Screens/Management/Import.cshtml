@* Разметка: functional.js: importScreen. Значения передаёт одноимённая функция JavaScript. *@
<script type="text/x-lingway-template" id="Management.Import.4">
<section class="card">
  <h2>1. Выберите файл</h2>
  <p>Первая строка должна содержать названия столбцов. CSV — в кодировке UTF-8.</p>
  <input
    type="file"
    accept=".csv,.xlsx"
    aria-label="Таблица для импорта"
    onchange="readImport(this)"
  />
  <p>{{value_0}}</p>
</section>
{{value_1}}{{value_2}}
</script>
